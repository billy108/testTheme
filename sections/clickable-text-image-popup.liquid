{% comment %}
  Section: 句子中某个单词点击弹出图片
  - 每个 block 表示一句话：前半句 + 可点击词 + 后半句
  - 只让中间的「关键词」可以点击，点击后弹出对应图片
  - 每个句子支持：PC 图片 + 移动端图片
  - 只上传其中一张时，PC 和移动端都用这一张
  - Section 可配置：上下内边距、字体、字号
{% endcomment %}

{%- liquid
  assign font_family_token = section.settings.font_family | default: 'theme_default'

  assign font_family_value = ''
  case font_family_token
    when 'system_sans'
      assign font_family_value = 'system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif'
    when 'helvetica'
      assign font_family_value = '"Helvetica Neue", Arial, sans-serif'
    when 'georgia'
      assign font_family_value = 'Georgia, "Times New Roman", serif'
    else
      assign font_family_value = ''
  endcase
-%}

<section
  id="inline-word-image-popup-{{ section.id }}"
  class="inline-word-image-popup"
  style="
    padding-top: {{ section.settings.padding_top | default: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | default: 0 }}px;
    {% if font_family_value != '' %}
      font-family: {{ font_family_value }};
    {% endif %}
    font-size: {{ section.settings.font_size | default: 16 }}px;
  "
>
  <div class="inline-word-image-popup__container">
    {% if section.settings.heading != blank %}
      <h2 class="inline-word-image-popup__heading">
        {{ section.settings.heading }}
      </h2>
    {% endif %}

    {% if section.blocks.size > 0 %}
      <div class="inline-word-image-popup__list">
        {% for block in section.blocks %}
          {% assign block_id = block.id | prepend: 'inline-word-popup-' %}

          {%- assign has_any_image = false -%}
          {%- if block.settings.image_desktop != blank or block.settings.image_mobile != blank -%}
            {%- assign has_any_image = true -%}
          {%- endif -%}

          <p class="inline-word-image-popup__sentence" {{ block.shopify_attributes }}>
            <span class="inline-word-image-popup__text inline-word-image-popup__text--before">
              {{ block.settings.text_before }}
            </span>

            {% if has_any_image %}
              <button
                type="button"
                class="inline-word-image-popup__keyword"
                data-popup-target="{{ block_id }}"
              >
                {{ block.settings.keyword }}
              </button>
            {% else %}
              <span class="inline-word-image-popup__keyword inline-word-image-popup__keyword--noimage">
                {{ block.settings.keyword }}
              </span>
            {% endif %}

            <span class="inline-word-image-popup__text inline-word-image-popup__text--after">
              {{ block.settings.text_after }}
            </span>
          </p>

          {% if has_any_image %}
            <div
              id="{{ block_id }}"
              class="inline-word-image-popup__overlay"
              aria-hidden="true"
            >
              <div class="inline-word-image-popup__overlay-backdrop" data-popup-close>
                <span aria-hidden="true"></span>
              </div>

              <div
                class="inline-word-image-popup__overlay-content"
                role="dialog"
                aria-modal="true"
              >
                <button
                  class="inline-word-image-popup__close"
                  type="button"
                  data-popup-close
                  aria-label="Close"
                ></button>

                <div class="inline-word-image-popup__image-wrapper">
                  <picture class="inline-word-image-popup__picture">
                    {%- if block.settings.image_mobile != blank -%}
                      <source
                        media="(max-width: 767px)"
                        srcset="{{ block.settings.image_mobile | image_url: width: 900 }}"
                      >
                    {%- endif -%}

                    {%- if block.settings.image_desktop != blank -%}
                      <source
                        media="(min-width: 768px)"
                        srcset="{{ block.settings.image_desktop | image_url: width: 1200 }}"
                      >
                    {%- endif -%}

                    {%- assign fallback_image = block.settings.image_desktop | default: block.settings.image_mobile -%}

                    <img
                      src="{{ fallback_image | image_url: width: 1000 }}"
                      alt="{{ block.settings.alt_text | escape }}"
                      loading="lazy"
                      class="inline-word-image-popup__image"
                      width="{{ fallback_image.width }}"
                      height="{{ fallback_image.height }}"
                    >
                  </picture>
                </div>

                {% if block.settings.caption != blank %}
                  <p class="inline-word-image-popup__caption">
                    {{ block.settings.caption }}
                  </p>
                {% endif %}
              </div>
            </div>
          {% endif %}
        {% endfor %}
      </div>
    {% endif %}
  </div>

  <style>
    .inline-word-image-popup__container {
      max-width: 960px;
      margin: 0 auto;
    }

    .inline-word-image-popup__heading {
      font-size: 1.5rem;
      margin-bottom: 1rem;
      text-align: center;
    }

    .inline-word-image-popup__list {
      display: flex;
      flex-direction: column;
      gap: 0.75rem;
    }

    .inline-word-image-popup__sentence {
      margin: 0;
      line-height: 1.6;
    }

    .inline-word-image-popup__keyword {
      background: none;
      border: none;
      padding: 0;
      margin: 0 2px;
      color: inherit;
      font: inherit;
      text-decoration: underline;
      cursor: pointer;
    }

    .inline-word-image-popup__keyword--noimage {
      text-decoration: underline;
      margin: 0 2px;
    }

    .inline-word-image-popup__overlay {
      position: fixed;
      inset: 0;
      display: none;
      align-items: center;
      justify-content: center;
      z-index: 9999;
    }

    .inline-word-image-popup__overlay.is-active {
      display: flex;
    }

    /* 透明灰色背景蒙层；注意内部有 span 避免 div:empty 被隐藏 */
    .inline-word-image-popup__overlay-backdrop {
      position: absolute;
      inset: 0;
      background: rgba(0, 0, 0, 0.5);
    }

    .inline-word-image-popup__overlay-content {
      position: relative;
      background: #fff;
      border-radius: 8px;
      max-width: 90vw;
      max-height: 85vh;
      padding: 16px;
      box-shadow: 0 10px 40px rgba(0, 0, 0, 0.3);
      z-index: 1;
      display: flex;
      flex-direction: column;
      align-items: center;
    }

    .inline-word-image-popup__image-wrapper {
      width: 100%;
      max-height: 70vh;
      overflow: hidden;
    }

    .inline-word-image-popup__image {
      width: 100%;
      height: auto;
      display: block;
    }

    .inline-word-image-popup__caption {
      margin-top: 0.5rem;
      font-size: 0.9rem;
      text-align: center;
    }

    /* 美化右上角关闭按钮：小圆形 + 精细 X */
    .inline-word-image-popup__close {
      position: absolute;
      top: 4px;
      right: 4px;
      width: 12px;
      height: 12px;
      border: none;
      border-radius: 999px;
      background: rgba(0, 0, 0, 0.06);
      cursor: pointer;
      padding: 0;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      transition:
        background-color 0.15s ease,
        transform 0.12s ease;
    }

    .inline-word-image-popup__close::before,
    .inline-word-image-popup__close::after {
      content: "";
      position: absolute;
      width: 14px;
      height: 2px;
      background-color: #222;
      border-radius: 999px;
    }

    .inline-word-image-popup__close::before {
      transform: rotate(45deg);
    }

    .inline-word-image-popup__close::after {
      transform: rotate(-45deg);
    }

    .inline-word-image-popup__close:hover,
    .inline-word-image-popup__close:focus-visible {
      background: rgba(0, 0, 0, 0.12);
      transform: scale(1.03);
      outline: none;
    }

    .inline-word-image-popup__close:active {
      background: rgba(0, 0, 0, 0.18);
      transform: scale(0.97);
    }

    @media (min-width: 768px) {
      .inline-word-image-popup__heading {
        font-size: 2rem;
      }

      .inline-word-image-popup__overlay-content {
        max-width: 640px;
      }
    }
  </style>

  <script>
    document.addEventListener('DOMContentLoaded', function() {
      var section = document.getElementById('inline-word-image-popup-{{ section.id }}');
      if (!section) return;

      var buttons = section.querySelectorAll('[data-popup-target]');

      var openOverlay = function(targetId) {
        var overlay = document.getElementById(targetId);
        if (!overlay) return;
        overlay.classList.add('is-active');
        overlay.setAttribute('aria-hidden', 'false');
      };

      var closeOverlay = function(overlay) {
        overlay.classList.remove('is-active');
        overlay.setAttribute('aria-hidden', 'true');
      };

      // 打开弹窗：点击“可点击单词”
      buttons.forEach(function(button) {
        button.addEventListener('click', function() {
          var targetId = this.getAttribute('data-popup-target');
          if (targetId) openOverlay(targetId);
        });
      });

      // 关闭弹窗：点击关闭按钮、点击弹窗外区域（灰色背景）
      section.addEventListener('click', function(event) {
        var target = event.target;

        // 1) 点的是关闭按钮（带 data-popup-close）
        if (target.hasAttribute('data-popup-close')) {
          var overlayFromClose = target.closest('.inline-word-image-popup__overlay');
          if (overlayFromClose) {
            closeOverlay(overlayFromClose);
          }
          return;
        }

        // 2) 点的是 overlay 区域（含灰色背景），但不在内容框内
        var overlay = target.closest('.inline-word-image-popup__overlay');
        if (overlay) {
          var content = overlay.querySelector('.inline-word-image-popup__overlay-content');

          // 如果点击点不在内容框里（即点击的是灰色背景或空白区域），就关闭
          if (!content.contains(target)) {
            closeOverlay(overlay);
          }
        }
      });

      // 按下 ESC 关闭所有弹窗
      document.addEventListener('keyup', function(event) {
        if (event.key === 'Escape' || event.key === 'Esc') {
          var activeOverlays = document.querySelectorAll('.inline-word-image-popup__overlay.is-active');
          activeOverlays.forEach(function(overlay) {
            closeOverlay(overlay);
          });
        }
      });
    });
  </script>

  {% schema %}
  {
    "name": "可点击文本图片",
    "settings": [
      {
        "type": "text",
        "id": "heading",
        "label": "标题",
      },
      {
        "type": "range",
        "id": "padding_top",
        "label": "上内边距（px）",
        "min": 0,
        "max": 100,
        "step": 4,
        "default": 0
      },
      {
        "type": "range",
        "id": "padding_bottom",
        "label": "下内边距（px）",
        "min": 0,
        "max": 100,
        "step": 4,
        "default": 0
      },
      {
        "type": "select",
        "id": "font_family",
        "label": "字体",
        "default": "theme_default",
        "options": [
          {
            "value": "theme_default",
            "label": "跟随主题默认字体"
          },
          {
            "value": "system_sans",
            "label": "系统无衬线字体"
          },
          {
            "value": "helvetica",
            "label": "无衬线：Helvetica / Arial"
          },
          {
            "value": "georgia",
            "label": "衬线：Georgia / Times"
          }
        ]
      },
      {
        "type": "range",
        "id": "font_size",
        "label": "字号（px）",
        "min": 12,
        "max": 24,
        "step": 1,
        "default": 14
      }
    ],
    "blocks": [
      {
        "type": "sentence",
        "name": "添加设置",
        "settings": [
          {
            "type": "text",
            "id": "text_before",
            "label": "可点击文本前的文字",
            "default": "这是一句示例，点击"
          },
          {
            "type": "text",
            "id": "keyword",
            "label": "可点击单词/短语",
            "default": "这里"
          },
          {
            "type": "text",
            "id": "text_after",
            "label": "可点击文本后的文字",
            "default": "可以查看图片。"
          },
          {
            "type": "image_picker",
            "id": "image_desktop",
            "label": "PC 端弹出图片（横图）"
          },
          {
            "type": "image_picker",
            "id": "image_mobile",
            "label": "移动端弹出图片（竖图）"
          },
          {
            "type": "text",
            "id": "alt_text",
            "label": "图片替代文本"
          },
          {
            "type": "text",
            "id": "caption",
            "label": "图片说明（可选）"
          }
        ]
      }
    ],
    "max_blocks": 30,
    "presets": [
      {
        "name": "单词点击弹出图片",
        "category": "自定义"
      }
    ]
  }
  {% endschema %}

  {% stylesheet %}
  {% endstylesheet %}

  {% javascript %}
  {% endjavascript %}
</section>